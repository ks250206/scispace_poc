{
  "name": "scispace_poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "binary:build": "pnpm build && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/scispace .",
    "binary:build:windows-x64": "pnpm build && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o bin/scispace-windows-x64.exe .",
    "lint": "eslint .",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@wterm/dom": "^0.5.9",
    "@wterm/just-bash": "^0.5.9",
    "@wterm/react": "^0.5.9",
    "dexie": "^4.4.7",
    "just-bash": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "uplot": "^1.6.32",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.16.1"
