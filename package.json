{
  "name": "scispace_poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "binary:build": "pnpm build && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/scispace .",
    "binary:build:windows-x64": "pnpm build && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o bin/scispace-windows-x64.exe .",
    "lint": "eslint .",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@wterm/dom": "^0.3.0",
    "@wterm/just-bash": "^0.3.0",
    "@wterm/react": "^0.3.0",
    "dexie": "^4.4.2",
    "just-bash": "^2.14.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-rnd": "^10.5.3",
    "uplot": "^1.6.32",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
